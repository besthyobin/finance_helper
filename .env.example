# API Keys — copy this file to .env.local and fill in your keys

# Financial Modeling Prep (무료 250 req/day) — https://financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# GNews API (무료 100 req/day) — https://gnews.io
GNEWS_API_KEY=your_gnews_api_key_here

# NewsAPI (무료 100 req/day, 개발용) — https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage (무료 25 req/day) — https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# 아래 변수들은 무료로 API 키 없이 사용 가능
# - yahoo-finance2 (npm 패키지, 키 불필요)
# - SEC EDGAR API (https://data.sec.gov, 키 불필요)
